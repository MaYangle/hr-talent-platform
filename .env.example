# Reference only: the Python process does not automatically read this file.
# Export these variables in your shell/service manager, or pass them to Docker.
TALENT_HOST=127.0.0.1
TALENT_PORT=4173
# Keep business data outside the Git working tree. Blank uses the user-local default.
TALENT_DATA_DIR=
TALENT_ALLOWED_HOSTS=
TALENT_SECURE_COOKIE=0
TALENT_SESSION_HOURS=8
TALENT_MAX_UPLOAD_MIB=20
TALENT_MAX_REQUEST_MIB=80
TALENT_MAX_BATCH_FILES=50
TALENT_REQUEST_TIMEOUT_SECONDS=30
TALENT_MODEL_TIMEOUT_SECONDS=120
TALENT_MODEL_API_KEY=
TALENT_OCR_LANG=chi_sim+eng
